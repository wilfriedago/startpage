    "@iconify-json/simple-icons": "^1.2.94",
    "@iconify/utils": "^3.1.4",
    "@preact/preset-vite": "^2.10.6",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.11",
